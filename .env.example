# Copy this file to .env on your own device. Never commit .env or share session strings.
# Telegram API credentials from my.telegram.org/apps (keep private)
# Telegram Account 1
TG_API_ID=
TG_API_HASH=
TG_SESSION=
# Required: only the specific channel/group IDs Account 1 should scrape.
# Comma-separated numeric IDs, e.g. 123456789,987654321
TG_CHANNELS_1=

# Telegram Account 2
TG_API_ID_2=
TG_API_HASH_2=
TG_SESSION_2=
# Required: only the specific channel/group IDs Account 2 should scrape.
TG_CHANNELS_2=

# MongoDB Atlas connection string for a restricted database user.
MONGODB_URI=
