{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 800,
        "includeFiles": [
          "routes/**",
          "models/**",
          "middleware/**",
          "utils/**",
          "pipeline_full.js",
          "scrape.js",
          "invite_tokens.json"
        ]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/watch",
      "dest": "public/watch.html"
    },
    {
      "src": "/movies",
      "dest": "public/movies.html"
    },
    {
      "src": "/shows",
      "dest": "public/shows.html"
    },
    {
      "src": "/anime",
      "dest": "public/anime.html"
    },
    {
      "src": "/search",
      "dest": "public/search.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}
