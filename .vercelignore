# Exclude heavy scraping tools from the Vercel serverless bundle.
# These are only used locally for the Telegram scraper pipeline,
# not by any web-facing API route.
node_modules/puppeteer
node_modules/puppeteer-extra
node_modules/puppeteer-extra-plugin-stealth
node_modules/.cache

# Local scripts — not needed on server
bypass_bot.js
bypasser.js
extract_links.js
heal_db.js
import_bypassed.js
scrape_api.js
share.js
wipe_db.js

# Data files that are too large or local-only
telegram_export.json
bypassed_links.json
