{
  "name": "xloop",
  "version": "1.0.0",
  "description": "Xloop OTT Streaming & Download Platform",
  "main": "server.js",
  "scripts": {

    "start": "node server.js",
    "dev": "nodemon server.js",

    "scrape": "node scrape-and-upload.js --mode=4",
    "scrape:full": "node scrape-and-upload.js --mode=1",
    "scrape:daily": "node scrape-and-upload.js --mode=4 --merge",
    "scrape:week": "node scrape-and-upload.js --mode=3 --days=7 --merge",
    "scrape:days": "node scrape-and-upload.js --mode=3 --days=30 --merge",
    "scrape:range": "node scrape-and-upload.js --mode=3 --start-date=2024-01-01 --end-date=2024-12-31 --merge",
    "scrape:specific": "node scrape-and-upload.js --mode=2 --merge",
    "scrape:upload-only": "node scrape-and-upload.js --upload-only",
    "scrape:no-pipeline": "node scrape-and-upload.js --no-pipeline",
    "scrape:acc2": "node scrape-and-upload.js --mode=4 --account=2",
    "scrape:acc2:full": "node scrape-and-upload.js --mode=1 --account=2",
    "scrape:acc2:week": "node scrape-and-upload.js --mode=3 --days=7 --account=2",
    "scrape:acc2:upload-only": "node scrape-and-upload.js --upload-only --merge",
    "scrape:both": "node scrape-and-upload.js --mode=4 --account=both",
    "scrape:both:full": "node scrape-and-upload.js --mode=1 --account=both",
    "scrape:both:week": "node scrape-and-upload.js --mode=3 --days=7 --account=both --merge",

    "upload": "node scrape-and-upload.js --upload-only",
    "upload:acc2": "node scrape-and-upload.js --upload-only --account=2",
    "upload:merge": "node scrape-and-upload.js --upload-only --merge",

    "pipeline:full": "node pipeline_full.js",
    "pipeline:daily": "node pipeline_full.js --scope=daily",
    "pipeline:no-wipe": "node pipeline_full.js --no-wipe",
    "pipeline:no-heal": "node pipeline_full.js --no-heal",
    "pipeline:import-only": "node pipeline_full.js --no-wipe --no-heal",
    "pipeline:resume": "node pipeline_full.js --resume --no-wipe",

    "import:db": "node pipeline_full.js --from-mongodb",
    "import:batch": "node pipeline_full.js --from-mongodb --no-wipe",

    "fix-db": "node fix_existing_db.js",
    "wipe": "node wipe_db.js",
    "heal": "node heal_db.js",

    "health": "node scripts/health-check.js",
    "health:verbose": "node scripts/health-check.js --verbose",

    "test:search": "node scripts/test-title-search.js --batch",
    "test:search:one": "node scripts/test-title-search.js",
    "test:search:json": "node scripts/test-title-search.js --batch --json",

    "validate:filesize": "node scripts/validate-filesize.js",
    "validate:filesize:fix": "node scripts/validate-filesize.js --fix",
    "validate:filesize:report": "node scripts/validate-filesize.js --report",

    "normalize:links": "node scripts/normalize-links.js",

    "share": "node share.js",
    "disable-sharing": "node scripts/disable-sharing.js",
    "enable-sharing": "node scripts/enable-sharing.js",

    "test": "node --test tests/*.test.js test/*.test.js",
    "test:all": "npm run test:pipeline-safety && npm run test:scraper-intelligence && npm run test:video-formats && npm run test:importer-metadata && npm run test:telegram-ingestion && npm run test:metadata-search && npm run test:media-ui && npm run test:search-ui && npm run test:quickpaste && npm run test:telegram-sync && npm run test:extracted-link-merge && npm run test:analytics-html",
    "test:unit": "node --test tests/*.test.js",
    "test:integration": "node --test test/*.test.js",
    "test:watch": "nodemon --exec 'node --test tests/*.test.js test/*.test.js' --watch tests --watch test --watch utils --watch routes --watch public/js",

    "test:pipeline-safety": "node --test tests/pipeline-scope.test.js tests/orchestrator-safety.test.js",
    "test:scraper-intelligence": "node --test tests/scraper-intelligence.test.js test/variant-intelligence.test.js",
    "test:video-formats": "node tests/video-format-detection.test.js",
    "test:importer-metadata": "node --test tests/importer-metadata.test.js tests/repack-media-metadata.test.js",
    "test:repack-metadata": "node --test tests/repack-media-metadata.test.js",
    "test:telegram-ingestion": "node --test tests/telegram-ingestion.test.js tests/telegram-ingestion-metadata.test.js",
    "test:metadata-search": "node --test tests/tmdb-search-shared.test.js tests/series-year-grouping.test.js tests/metadata-reconciliation.test.js",
    "test:media-ui": "node --test tests/audio-codec-detection.test.js tests/telegram-ingestion-metadata.test.js tests/watch-download-display.test.js tests/responsive-viewport.test.js",
    "test:search-ui": "node --test test/search-ui-regressions.test.js",
    "test:quickpaste": "node --test test/quick-paste-metadata.test.js test/quick-paste-integration.test.js",
    "test:telegram-sync": "node --test test/telegram-sync-contract.test.js",
    "test:extracted-link-merge": "node --test tests/extracted-link-merge.test.js",
    "test:series-grouping": "node --test tests/series-year-grouping.test.js",
    "test:analytics-html": "node test/analytics-html.test.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "axios-cookiejar-support": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "duck-duck-scrape": "^2.2.7",
    "duckduckgo-images-api": "^1.0.5",
    "express": "^4.18.2",
    "googlethis": "^1.8.0",
    "imdb-api": "^4.4.1",
    "imdb-scraper": "^2.1.0",
    "input": "^1.0.1",
    "jsdom": "^30.1.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.5.0",
    "multer": "^2.4.0",
    "puppeteer": "^25.9.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "telegram": "^2.26.22",
    "tough-cookie": "^6.0.2",
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "localtunnel": "^2.0.2",
    "nodemon": "^3.0.1"
  }
}
